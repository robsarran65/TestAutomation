# Copy to .env and adjust. Real environment variables take precedence over
# this file, so CI/Docker settings always win.

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_PORT=8501

# --- AI provider ---
# stub | openai | claude   ("stub" runs fully offline, no key required)
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Security ---
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional infrastructure (only used if you wire up persistence) ---
DATABASE_URL=
REDIS_URL=

# --- Deployment ---
# Where outputs/ and data/ live. Leave unset in a source checkout (the repo
# root is detected automatically). Set it when running from an installed
# package so reports land in a known writable directory instead of the
# current working directory.
# AI_TEST_ENGINE_HOME=/var/lib/ai-test-engine

# --- Browser (see README for the full table) ---
# HEADLESS=true          # REQUIRED on servers/containers/CI - no display
# DEFAULT_TIMEOUT=10     # seconds Selenium retries a locator
# PAGE_LOAD_TIMEOUT=60
# API_TIMEOUT=30
# VERIFY_SSL=true        # false only for an internal CA
# WINDOW_WIDTH=1920
# WINDOW_HEIGHT=1080
# SCREENSHOT_ON_FAILURE=true

# Note: report/log locations are NOT configurable beyond AI_TEST_ENGINE_HOME.
# They are always <home>/outputs/{reports,logs,screenshots}.
